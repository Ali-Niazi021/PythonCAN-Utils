# Backend Configuration Example
# Copy to .env and modify as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# CORS Settings (for production, specify frontend domain)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info

# Default CAN Settings (optional)
DEFAULT_DEVICE_TYPE=pcan
DEFAULT_CHANNEL=USB1
DEFAULT_BAUDRATE=BAUD_500K

# Live Stream Forwarder (push CAN traffic to an external time-series DB)
# These are startup defaults; they can also be changed at runtime via
# POST /stream/forward/config (persisted to stream_forward_config.json).
STREAM_FORWARD_ENABLED=false
# InfluxDB v2 example (note precision=ns to match the forwarder's timestamps):
STREAM_FORWARD_URL=http://dbhost:8086/api/v2/write?org=trev&bucket=can&precision=ns
STREAM_FORWARD_TOKEN=
STREAM_FORWARD_SERIALIZER=influx
STREAM_FORWARD_BATCH_SIZE=5000
STREAM_FORWARD_FLUSH_MS=250
STREAM_FORWARD_QUEUE_MAX=50000
STREAM_FORWARD_INCLUDE_FRAMES=true
STREAM_FORWARD_INCLUDE_SIGNALS=true
